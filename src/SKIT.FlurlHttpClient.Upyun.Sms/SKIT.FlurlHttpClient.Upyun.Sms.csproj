<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net462; netstandard2.0; net6.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>SKIT.FlurlHttpClient.Upyun.Sms</PackageId>
		<PackageVersion>4.0.0-dev</PackageVersion>
		<PackageIcon>LOGO.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.FlurlHttpClient.Upyun</PackageProjectUrl>
		<PackageTags>Flurl.Http; Upyun; 又拍; 又拍云; 短信; SMS</PackageTags>
		<Authors>Fu Diwei</Authors>
		<Description>基于 Flurl.Http 的又拍云短信服务（SMS）API 客户端。</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../LOGO.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="ModelsFixtures/**/*.json" />
	</ItemGroup>

	<ItemGroup>
        <PackageReference Include="SKIT.FlurlHttpClient.Common" Version="4.0.1" />
        <PackageReference Include="SKIT.JsonConv.NewtonsoftJson" Version="0.1.2" />
        <PackageReference Include="SKIT.JsonConv.SystemTextJson" Version="0.1.2" />
	</ItemGroup>

</Project>
