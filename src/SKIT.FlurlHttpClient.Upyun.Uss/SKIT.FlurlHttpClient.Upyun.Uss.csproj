<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
        <TargetFrameworks>netstandard2.0; net462; net6.0; net8.0; net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>SKIT.FlurlHttpClient.Upyun.Uss</PackageId>
		<PackageVersion>4.0.0</PackageVersion>
		<PackageIcon>LOGO.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/fudiwei/DotNetCore.SKIT.FlurlHttpClient.Upyun</PackageProjectUrl>
		<PackageTags>Flurl.Http; Upyun; 又拍; 又拍云; 云存储; 对象存储; 文件存储; USS</PackageTags>
		<Authors>Fu Diwei</Authors>
		<Description>基于 Flurl.Http 的又拍云云存储服务（USS）API 客户端 SDK。</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../LOGO.png" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="ModelsFixtures/**/*.*" />
	</ItemGroup>

	<ItemGroup>
        <PackageReference Include="SKIT.FlurlHttpClient.Common" Version="4.0.1" />
        <PackageReference Include="SKIT.JsonConv.NewtonsoftJson" Version="0.1.2" />
        <PackageReference Include="SKIT.JsonConv.SystemTextJson" Version="0.1.2" />
	</ItemGroup>

</Project>
